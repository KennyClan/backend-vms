# Copy to .env and fill in real values. Never commit the real .env.
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"

# JWT signing secret (required everywhere)
SECRET_KEY=
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost/vista_vms

# EmailJS (mandatory for QR/status emails to send)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_QR_ID=
# Optional second template for status emails; blank = reuse the QR template
EMAILJS_TEMPLATE_STATUS_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Demo account seeding
# Passwords are read from these env vars ONLY — nothing is hardcoded, and an
# account whose var is unset is simply not created.
# Auto-seed on startup runs by default only when the DB is localhost/127.0.0.1,
# or when SEED_DEMO=1/true explicitly. Set SEED_DEMO=false/0 on prod to force
# skip even against a local-style URL.
SEED_SUPERADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_RECEP_PASSWORD=
SEED_GUARD_PASSWORD=
SEED_EMPLOYEE_PASSWORD=
# SEED_DEMO=true   # uncomment to force demo seeding anywhere